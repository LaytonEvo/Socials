__pycache__/
*.py[cod]
.venv
.mypy_cache/
.pytest_cache/
.ruff_cache/
.env

# Spike run outputs: media and logs are evidence, not source.
# Gate report is promoted to docs/reports/ by hand.
spike/runs/
ci-spike.yaml

# Fetched model weights. Downloadable from their upstream source, so they are
# not source: `fetch-models` gets them and verifies the bytes. The one
# exception is committed on purpose -- face_recognition_densenet_model_v1.dat
# has no working download (ADR 0002), so the file itself is the only copy.
spike/models/*.dat
!spike/models/face_recognition_densenet_model_v1.dat

# Build metadata. Globbed, not named: the distribution was renamed from
# persona-studio-spike to persona-studio and the old entry stopped matching.
*.egg-info/

# setuptools wheel build artefacts (`pip install .` leaves these behind)
build/
dist/

# Renders copied to the repository root so the desktop app can open them — it
# cannot reach into spike/runs/. Same bytes, same reasoning as spike/runs/:
# evidence, not source. The scores that make a render worth keeping are in
# docs/reports/, which is where the finding actually lives.
/*.mp4
/*.png
