# Secrets come from the environment only — never from a file in the repository
# and never from a default in code. Copy to `.env` for local work; `.env` is
# gitignored. In the cloud environment these are set in the environment's
# settings, not here.
#
# Keep this file current: it is the list of every secret the system reads, and
# it is the only place someone can find that out without reading the code.

# --- Providers -------------------------------------------------------------

# fal.ai API key (ADR 0005). Covers both Spike 0 slots that need one: the
# flagship video model (S0.5) and FLUX LoRA training (S0.4).
# Variable name follows fal's own convention; confirm against their docs before
# the adapter is written, since an assumed name is a silent failure at runtime.
FAL_KEY=

# Anthropic API key, for the shot-list generator and caption writer (tasks 3.1
# and 3.9). This is the only place Claude appears inside the running product;
# it is called through `app/providers/` like any other adapter.
# Not yet used — no LLM adapter exists. Listed because `config/providers.yaml`
# names it, and this file is the list of every secret the system reads.
ANTHROPIC_API_KEY=

# --- C2PA signing (task 3.11) ---------------------------------------------
# The certificate CHAIN and private key used to sign a finished render.
# Each value is either PEM text or a path to a PEM file.
#
# The chain is the end-entity certificate FIRST, then its issuer. A lone
# self-signed certificate is refused by the library ("the certificate is
# invalid"), because the C2PA certificate profile wants a chain. The key must
# be in PKCS#8 form (its PEM label reads PRIVATE KEY, not EC PRIVATE KEY);
# a SEC1 EC key is refused by the library.
#
# Generate a development pair with:
#   python -m scripts.make_signing_cert --out ~/.persona-studio/c2pa
#
# That signs as VALID — the file has not been altered since signing — and never
# as TRUSTED, which needs a certificate from an authority on the C2PA trust
# list. Amendment A9 records that as procurement with lead time.
C2PA_SIGN_CERT=
# A SECRET. Never commit it, never let it sit in a casual backup. In production
# it belongs in a KMS or HSM, which the bindings support via a callback signer.
C2PA_SIGN_KEY=

# --- Database -------------------------------------------------------------

# Postgres connection string, used by the app and by `make migrate`. Needs the
# pgvector extension available: amendment A3 stores embeddings as vectors, and
# the first migration creates the extension itself.
#
# It has NO DEFAULT in code, deliberately. A fallback to a local database is how
# a test suite passes against the wrong data and how a migration lands somewhere
# nobody intended.
#   local:   postgresql+psycopg://studio:studio@127.0.0.1:5432/persona_studio
#   Railway: taken from the Postgres service's own variable
DATABASE_URL=

# --- Object storage --------------------------------------------------------

# S3-compatible bucket for all media: master stills, keyframes, takes, voice
# lines, renders, C2PA manifests and platform exports. The database stores keys,
# never blobs (BUILD_PLAN Section 3).
#
# No default, for the same reason as DATABASE_URL: writing media into whichever
# bucket happened to be configured is not a recoverable mistake.
#
# The literal value `memory` selects the in-memory backend instead, so the
# pipeline can run offline with no cloud and no special code path.
S3_BUCKET=

# Only for a non-AWS bucket — Railway's own, MinIO, Cloudflare R2, Backblaze.
# Leave empty for AWS.
S3_ENDPOINT_URL=
S3_REGION=

# Standard AWS credential variables, read by boto3 itself. On Railway these come
# from the bucket service's own variables rather than being set by hand.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Job queue -------------------------------------------------------------

# Redis, for the arq queue. Generation calls are slow and async, so they run in a
# worker rather than in a request (BUILD_PLAN Section 3).
#
# No default, like DATABASE_URL and S3_BUCKET. A fallback to localhost is how a
# worker quietly consumes a different queue from the one the web process fills,
# with nothing reporting it.
#   local:   redis://127.0.0.1:6379/0
#   Railway: taken from the Redis service's own variable
REDIS_URL=

# --- Notes -----------------------------------------------------------------
#
# There is no budget variable. Spend caps are passed per command as `--budget`,
# deliberately: a budget in the environment would apply silently to every run,
# and amendment A7 requires no live call outside an explicitly budgeted one.
